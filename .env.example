# Copy to ".env" locally. Never commit real secrets.
# On Vercel, set the same keys in Project → Settings → Environment Variables.

# --- Auth.js ---
# Generate with: npx auth secret
AUTH_SECRET=""
# Local: http://localhost:8080 (npm run dev). Production: https://YOUR_DOMAIN
AUTH_URL="http://localhost:8080"

# Magic-link email. Local login needs a real Resend key (copy from Coolify).
AUTH_RESEND_KEY=""
EMAIL_FROM="Subscription Tracker <noreply@example.com>"

# --- Postgres ---
# Local (no SSL). Start the DB first: npm run db:up
# See LOCAL.md. Do not point this at the Coolify production database.
DATABASE_URL="postgresql://postgres:PASSWORD@127.0.0.1:5432/subscription_tracker"
# Production / Coolify: postgresql://postgres:PASSWORD@HOST:5432/postgres
# (sslmode=require only if the host actually requires TLS, e.g. Neon)

# --- Vercel Cron (used when reminder emails land) ---
CRON_SECRET=""
