# Copy to ".env" locally. Never commit real secrets.
# On Vercel, set the same keys in Project → Settings → Environment Variables.

# --- Auth.js ---
# Generate with: npx auth secret
AUTH_SECRET=""
# Production: https://YOUR_DOMAIN. Leave empty in local preview.
AUTH_URL="http://localhost:3000"

# Magic-link email (v1). Leave empty until Resend is connected.
AUTH_RESEND_KEY=""
EMAIL_FROM="Subscription Tracker <noreply@example.com>"

# --- Postgres (Neon) ---
# Neon dashboard → Connection string (pooled / -pooler host).
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# --- Vercel Cron (used when reminder emails land) ---
CRON_SECRET=""
